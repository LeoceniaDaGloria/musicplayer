<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Toolbar para título do aplicativo e navegação -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="@string/app_name"
        app:title="Music Player"
        android:titleTextColor="@color/white"
        app:navigationIcon="@drawable/chevron_right"/>

    <!-- ✅ CONTEÚDO CENTRALIZADO VERTICALMENTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="?android:attr/colorBackground">

        <!-- Capa do álbum -->
        <ImageView
            android:id="@+id/album_cover"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_lm_capa_placeholder"
            android:layout_marginBottom="32dp"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:clickable="false"
            android:focusable="false" />

        <!-- Informações da música -->
        <TextView
            android:id="@+id/song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título da Música"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/artist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome do Artista"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- ✅ Botão favorito -->
        <ImageView
            android:id="@+id/favorite_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_star_outline"
            android:contentDescription="Favorito"
            android:layout_marginBottom="32dp"
            app:tint="?android:attr/textColorPrimary" />

        <!-- ✅ SeekBar e tempos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tv_tempo_atual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginEnd="12dp" />

            <SeekBar
                android:id="@+id/song_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="?attr/colorPrimary"
                android:thumbTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tv_duracao_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- ✅ Controles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/shuffleButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_shuffle"
                android:layout_margin="12dp"
                app:tint="?android:attr/textColorPrimary" />

            <ImageView
                android:id="@+id/prevButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_skip_previous"
                android:layout_margin="12dp"
                app:tint="?android:attr/textColorPrimary" />

            <ImageView
                android:id="@+id/playPauseButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_play_arrow"
                android:layout_margin="12dp"
                app:tint="?android:attr/textColorPrimary" />

            <ImageView
                android:id="@+id/nextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_skip_next"
                android:layout_margin="12dp"
                app:tint="?android:attr/textColorPrimary" />

            <ImageView
                android:id="@+id/repeatButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_repeat"
                android:layout_margin="12dp"
                app:tint="?android:attr/textColorPrimary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>