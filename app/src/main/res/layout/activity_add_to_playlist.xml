<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="Adicionar Músicas"
        android:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_chevron_right" />

    <!-- Contador de seleção -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/surface_light">

        <TextView
            android:id="@+id/tv_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 músicas selecionadas"
            android:textSize="17sp"
            android:background="@color/black"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_add_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adicionar"
            android:enabled="false"
            android:textColor="@color/white"
            android:textSize="17dp"
            android:backgroundTint="@color/colorPrimary" />

    </LinearLayout>

    <!-- Lista de músicas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp" />

    <!-- Estado vazio -->
    <TextView
        android:id="@+id/empty_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="Nenhuma música encontrada"
        android:gravity="center"
        android:textSize="16sp"
        android:textColor="@color/text_secondary_light"
        android:visibility="gone" />



</LinearLayout>