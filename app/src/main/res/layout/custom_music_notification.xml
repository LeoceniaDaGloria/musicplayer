<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Capa do Álbum -->
    <ImageView
        android:id="@+id/notification_album_art"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_lm_capa_placeholder"
        android:scaleType="centerCrop"
        android:layout_marginEnd="16dp" />

    <!-- Informações da Música -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título da Música"
            android:textColor="#212121"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artista"
            android:textColor="#757575"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Controles de Música - com ImageView-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="8dp">

        <!-- Shuffle -->
        <ImageView
            android:id="@+id/btn_shuffle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_shuffle"
            android:padding="8dp"
            android:contentDescription="Embaralhar"
            android:scaleType="centerInside"
            android:layout_marginEnd="4dp" />

        <!-- Anterior -->
        <ImageView
            android:id="@+id/btn_previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_skip_previous"
            android:padding="8dp"
            android:contentDescription="Música anterior"
            android:scaleType="centerInside"
            android:layout_marginEnd="4dp" />

        <!-- Play/Pause -->
        <ImageView
            android:id="@+id/btn_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_play_arrow"
            android:padding="8dp"
            android:contentDescription="Play/Pause"
            android:scaleType="centerInside"
            android:layout_marginEnd="4dp" />

        <!-- Próxima -->
        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_skip_next"
            android:padding="8dp"
            android:contentDescription="Próxima música"
            android:scaleType="centerInside"
            android:layout_marginEnd="4dp" />

        <!-- Repeat -->
        <ImageView
            android:id="@+id/btn_repeat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_repeat"
            android:padding="8dp"
            android:contentDescription="Repetir"
            android:scaleType="centerInside"
            android:layout_marginEnd="8dp" />

        <!-- Parar -->
        <ImageView
            android:id="@+id/btn_stop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_pause"
            android:padding="8dp"
            android:contentDescription="Parar"
            android:scaleType="centerInside" />

    </LinearLayout>

</LinearLayout>