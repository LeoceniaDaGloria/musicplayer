<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Toolbar-->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:title="@string/app_name"
        app:title="Music Player"
        android:titleTextColor="@color/white"
        app:navigationIcon="@drawable/chevron_right"/>

    <!-- Conteúdo da activity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reconhecer Música"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Resultado do Reconhecimento -->
        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque no icone para reconhecer música..."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textAlignment="center"
            android:lineSpacingExtra="8dp"
            android:layout_marginBottom="48dp"
            android:padding="16dp" />

        <!-- Botão Shazam -->
        <ImageView
            android:id="@+id/recognize_button"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_shazam"
            android:background="@drawable/circle_shazam_background"
            android:contentDescription="Reconhecer música"
            android:scaleType="centerInside"
            android:padding="24dp" />

        <!-- Texto do botão -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toque para reconhecer"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <!-- Progresso -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="32dp"
            android:indeterminateTint="?attr/colorPrimary" />

        <!-- Botão para reproduzir música reconhecida -->
        <Button
            android:id="@+id/btn_play_recognized"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reproduzir Música"
            android:textColor="@color/white"
            android:backgroundTint="?attr/colorAccent"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Botão para voltar -->
        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:textColor="?android:attr/textColorPrimary"
            android:backgroundTint="?android:attr/textColorSecondary"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>