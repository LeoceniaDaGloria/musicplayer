<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Imagem da Playlist (placeholder para futura imagem de fundo) -->
    <ImageView
        android:id="@+id/playlist_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/album"
        android:scaleType="centerCrop"
        android:contentDescription="Imagem da playlist"
        android:layout_marginEnd="16dp" />

    <!-- Informações da Playlist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/playlist_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome da Playlist"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/playlist_song_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="sua lista"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/playlist_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="desfrute"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Ícone de seta -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="Abrir playlist"
        app:tint="?android:attr/textColorSecondary" />

</LinearLayout>